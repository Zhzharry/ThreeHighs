MYSQL_ROOT_PASSWORD=please-change-this-password
MYSQL_USER=three_high_app
MYSQL_PASSWORD=please-change-this-app-password
APP_ENV=production
DATABASE_URL=mysql+pymysql://three_high_app:please-change-this-app-password@mysql:3306/three_high_health
SECRET_KEY=please-change-this-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate-with-werkzeug-security
DOMAIN_REPOSITORIES_ENABLED=true
AUTH_REQUIRED=true
AUTO_CREATE_TABLES=false
CORS_ORIGINS=
RATELIMIT_STORAGE_URI=redis://redis:6379/0
RATELIMIT_DEFAULT=200 per minute
WECHAT_LOGIN_RATE_LIMIT=30 per minute
ADMIN_LOGIN_RATE_LIMIT=5 per minute
TOKEN_MAX_AGE_SECONDS=604800
TOKEN_VERSION_REQUIRED=true
WECHAT_LOGIN_MODE=code2session
WECHAT_APP_ID=wx-your-production-appid
WECHAT_APP_SECRET=replace-with-secret-from-secure-vault
WECHAT_API_TIMEOUT_SECONDS=5
PRIVACY_POLICY_VERSION=2026-08-23
USER_AGREEMENT_VERSION=2026-08-23
HEALTH_DATA_CONSENT_VERSION=2026-08-23
HEALTH_CONSENT_REQUIRED=true
TRUST_PROXY_COUNT=1
DB_POOL_RECYCLE_SECONDS=1800
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
DOCKER_BASE_REGISTRY=public.ecr.aws/docker/library
