page {
  min-height: 100%;
  background: #f4f8f7;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
  box-sizing: border-box;
}

view,
text,
navigator,
button {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 28rpx 24rpx 48rpx;
}

.hero {
  padding: 36rpx 32rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0f766e 0%, #16a34a 58%, #f59e0b 140%);
  box-shadow: 0 18rpx 42rpx rgba(15, 118, 110, 0.22);
}

.eyebrow {
  display: block;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 34rpx;
}

.hero-title {
  display: block;
  margin-top: 12rpx;
  font-size: 44rpx;
  line-height: 56rpx;
  font-weight: 700;
}

.hero-desc {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.88);
  font-size: 26rpx;
  line-height: 38rpx;
}

.section {
  margin-top: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.section-title {
  color: #111827;
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 700;
}

.section-note {
  color: #6b7280;
  font-size: 24rpx;
}

.card {
  padding: 28rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.06);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.value {
  color: #111827;
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 700;
}

.unit {
  margin-left: 4rpx;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 400;
}

.tag {
  display: inline-block;
  min-height: 42rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  color: #0f766e;
  background: #ccfbf1;
  font-size: 22rpx;
  line-height: 28rpx;
}

.tag-warn {
  color: #92400e;
  background: #fef3c7;
}

.tag-danger {
  color: #991b1b;
  background: #fee2e2;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: -10rpx;
}

.grid-item {
  width: 50%;
  padding: 10rpx;
}

.nav-card {
  display: block;
  min-height: 162rpx;
  padding: 24rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #ffffff;
}

.nav-title {
  display: block;
  color: #111827;
  font-size: 28rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.nav-desc {
  display: block;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 23rpx;
  line-height: 32rpx;
}

.progress {
  overflow: hidden;
  height: 14rpx;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #0f766e, #22c55e);
}

.progress-warn {
  background: linear-gradient(90deg, #f59e0b, #ef4444);
}

.list {
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #ffffff;
}

.list-row {
  padding: 24rpx 26rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.list-row:last-child {
  border-bottom: 0;
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 26rpx;
  border-radius: 12rpx;
  color: #ffffff;
  background: #0f766e;
  font-size: 26rpx;
  line-height: 72rpx;
}

button.button {
  margin: 0;
  border: 0;
}

button::after {
  border: 0;
}

.button-secondary {
  color: #0f766e;
  background: #e0f2f1;
}

.chart {
  display: flex;
  align-items: flex-end;
  height: 230rpx;
  padding: 20rpx 8rpx 0;
}

.bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
}

.bar {
  width: 34rpx;
  min-height: 18rpx;
  border-radius: 999rpx 999rpx 6rpx 6rpx;
  background: #0f766e;
}

.bar-alt {
  background: #f59e0b;
}

.bar-label {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 20rpx;
}

.empty-space {
  height: 18rpx;
}
