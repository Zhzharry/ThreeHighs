.diet-hero {
  background: linear-gradient(135deg, #16a34a 0%, #0f766e 82%);
}

.nutrient-card {
  padding-bottom: 4rpx;
}

.nutrient-row {
  margin-bottom: 24rpx;
}

.nutrient-label {
  color: #111827;
  font-size: 27rpx;
  font-weight: 700;
}

.nutrient-value {
  color: #6b7280;
  font-size: 24rpx;
}

.nutrient-progress {
  margin-top: 14rpx;
}

.meal-card {
  margin-bottom: 18rpx;
}

.meal-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.meal-foods {
  display: block;
  margin-top: 18rpx;
  color: #374151;
  font-size: 27rpx;
  line-height: 38rpx;
}

.meal-advice {
  display: block;
  margin-top: 12rpx;
  color: #0f766e;
  font-size: 25rpx;
  line-height: 36rpx;
}

.tip-text {
  color: #374151;
  font-size: 26rpx;
  line-height: 38rpx;
}
