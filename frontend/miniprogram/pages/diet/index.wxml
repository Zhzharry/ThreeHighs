<view class="page">
  <view class="hero diet-hero">
    <text class="eyebrow">今日饮食记录</text>
    <text class="hero-title">{{dateText}}</text>
    <text class="hero-desc">统计热量、糖分、脂肪、盐分，并给出控糖、控压、控脂建议。</text>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">营养摄入</text>
      <text class="section-note">目标完成度</text>
    </view>
    <view class="card nutrient-card">
      <view class="nutrient-row" wx:for="{{nutrients}}" wx:key="label">
        <view class="row">
          <text class="nutrient-label">{{item.label}}</text>
          <text class="nutrient-value">{{item.value}} · {{item.status}}</text>
        </view>
        <view class="progress nutrient-progress">
          <view class="progress-bar {{item.label === '盐分' ? 'progress-warn' : ''}}" style="width: {{item.percent}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">三餐记录</text>
      <text class="section-note">静态数据</text>
    </view>
    <view class="meal-card card" wx:for="{{meals}}" wx:key="name">
      <view class="row">
        <text class="meal-title">{{item.name}}</text>
        <text class="tag">{{item.calories}}</text>
      </view>
      <text class="meal-foods">{{item.foods}}</text>
      <text class="meal-advice">{{item.advice}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">饮食建议</text>
    </view>
    <view class="list">
      <view class="list-row" wx:for="{{tips}}" wx:key="*this">
        <text class="tip-text">{{item}}</text>
      </view>
    </view>
  </view>
</view>
