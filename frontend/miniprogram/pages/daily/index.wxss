.daily-page {
  padding-bottom: 72rpx;
}

.daily-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 34rpx 30rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #0f766e 0%, #16a34a 100%);
  box-shadow: 0 18rpx 42rpx rgba(15, 118, 110, 0.2);
}

.eyebrow-dark {
  display: block;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}

.daily-title {
  display: block;
  margin-top: 10rpx;
  font-size: 42rpx;
  line-height: 52rpx;
  font-weight: 700;
}

.daily-subtitle {
  display: block;
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 23rpx;
}

.score-pill {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border: 8rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 999rpx;
}

.score-number {
  font-size: 34rpx;
  font-weight: 700;
}

.score-label {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 20rpx;
}

.calendar-card {
  margin-top: 26rpx;
  padding: 26rpx 22rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.06);
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.calendar-open {
  padding: 10rpx 0 10rpx 20rpx;
  color: #0f766e;
}

.calendar-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #f8fafc;
}

.calendar-summary-title {
  display: block;
  color: #111827;
  font-size: 31rpx;
  font-weight: 700;
}

.calendar-summary-lunar {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
}

.calendar-summary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 56rpx;
  border-radius: 12rpx;
  color: #0f766e;
  background: #e0f2f1;
  font-size: 24rpx;
  font-weight: 700;
}

.calendar-modal-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 36rpx 0 0;
  background: rgba(15, 23, 42, 0.32);
}

.calendar-modal {
  width: 100%;
  padding: 28rpx 18rpx 30rpx;
  border-radius: 0 0 28rpx 28rpx;
  background: #f8fcfb;
  box-shadow: 0 22rpx 58rpx rgba(15, 23, 42, 0.18);
}

.big-calendar-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 0 2rpx 24rpx;
  border-bottom: 1rpx solid #e5e7eb;
}

.big-date-title,
.big-date-lunar {
  display: block;
}

.big-date-title {
  color: #111827;
  font-size: 30rpx;
  line-height: 42rpx;
}

.big-date-lunar {
  margin-top: 10rpx;
  color: #475569;
  font-size: 27rpx;
}

.calendar-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 56rpx;
  border-radius: 10rpx;
  color: #111827;
  background: #ffffff;
  font-size: 22rpx;
  line-height: 56rpx;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.08);
}

.big-month-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 2rpx 24rpx;
}

.big-month-head > text {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.month-arrow-group {
  display: flex;
  align-items: center;
}

.month-arrow {
  margin-left: 42rpx;
  color: #8b9491;
  font-size: 24rpx;
}

.weekday-row,
.month-grid {
  display: flex;
  flex-wrap: wrap;
}

.weekday-row text {
  width: 14.2857%;
  padding: 8rpx 0 22rpx;
  color: #111827;
  font-size: 27rpx;
  text-align: center;
  font-weight: 700;
}

.month-day {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 14.2857%;
  height: 84rpx;
  margin-bottom: 8rpx;
  border-radius: 999rpx;
  color: #111827;
}

.month-day.outside {
  color: #9ca3af;
}

.month-day.muted-day {
  background: #edf3f1;
}

.month-day.active {
  color: #ffffff;
  background: #0b72c9;
}

.month-day-number {
  font-size: 29rpx;
  line-height: 34rpx;
}

.month-day-lunar {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 28rpx;
}

.panel-tabs {
  display: flex;
  margin-top: 24rpx;
  padding: 6rpx;
  border: 1rpx solid #dbe7e4;
  border-radius: 16rpx;
  background: #ffffff;
}

.panel-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border-radius: 12rpx;
  color: #64748b;
  font-size: 25rpx;
}

.panel-tab.active {
  color: #ffffff;
  background: #0f766e;
  font-weight: 700;
}

.month-strip {
  display: flex;
  margin-top: 18rpx;
  padding: 18rpx 8rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  background: #ffffff;
}

.month-item {
  flex: 1;
  text-align: center;
}

.month-value {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.month-label {
  display: block;
  margin-top: 6rpx;
  color: #64748b;
  font-size: 22rpx;
}

.metric-card {
  min-height: 174rpx;
}

.metric-value {
  display: block;
  margin: 14rpx 0 14rpx;
  font-size: 32rpx;
}

.full-item {
  width: 100%;
}

.form-card {
  padding-bottom: 18rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
}

.form-label {
  color: #374151;
  font-size: 26rpx;
}

.fake-input {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 230rpx;
  height: 62rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  color: #111827;
  background: #f8fafc;
  font-size: 27rpx;
  font-weight: 700;
}

.input-unit {
  margin-left: 8rpx;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 400;
}

.save-button,
.add-button {
  margin-top: 22rpx;
}

.meal-name,
.nutrition-label {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.meal-text {
  display: block;
  margin-top: 10rpx;
  color: #374151;
  font-size: 25rpx;
  line-height: 36rpx;
}

.meal-meta {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.meal-meta text {
  margin-right: 18rpx;
  color: #64748b;
  font-size: 23rpx;
}

.todo-form {
  padding: 0;
  overflow: hidden;
}

.todo-form-row {
  display: flex;
  align-items: center;
  padding: 18rpx 18rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.todo-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  color: #111827;
  background: #f8fafc;
  font-size: 27rpx;
}

.todo-status {
  flex-shrink: 0;
  margin-left: 12rpx;
}

.todo-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 58rpx;
  height: 54rpx;
  margin: 0 0 0 10rpx;
  border-radius: 12rpx;
  color: #64748b;
  background: #f1f5f9;
  font-size: 22rpx;
  line-height: 54rpx;
  font-weight: 700;
}

.todo-form .add-button {
  margin: 18rpx;
}

.summary-card {
  margin-bottom: 16rpx;
  background: #f8fafc;
}

.summary-title {
  display: block;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.summary-desc {
  display: block;
  margin-top: 10rpx;
  color: #374151;
  font-size: 25rpx;
  line-height: 38rpx;
}

.alert-card {
  padding-bottom: 10rpx;
  background: #fffbeb;
}

.alert-text {
  display: block;
  margin-bottom: 16rpx;
  color: #92400e;
  font-size: 26rpx;
  line-height: 38rpx;
}

.nutrition-card {
  padding-bottom: 4rpx;
}

.nutrition-row {
  margin-bottom: 24rpx;
}

.nutrition-value {
  color: #64748b;
  font-size: 24rpx;
}

.nutrition-progress {
  margin-top: 14rpx;
}

.legend-row {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 4rpx;
}

.legend {
  margin-left: 24rpx;
  color: #64748b;
  font-size: 22rpx;
}

.legend::before {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  margin-right: 8rpx;
  border-radius: 999rpx;
  content: "";
}

.legend.bp::before {
  background: #0f766e;
}

.legend.sugar::before {
  background: #f59e0b;
}

.dual-bars {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  height: 180rpx;
}

.dual-bars .bar {
  width: 22rpx;
  margin: 0 4rpx;
}

.predict-card {
  background: #ecfdf5;
}

.predict-text {
  display: block;
  margin-top: 12rpx;
  color: #065f46;
  font-size: 26rpx;
  line-height: 38rpx;
}

.upload-title {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.upload-desc,
.report-value {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
}

.upload-dropzone {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 286rpx;
  padding: 32rpx 24rpx;
  border: 3rpx dashed #99c8c1;
  border-radius: 18rpx;
  background: #fbfffe;
}

.upload-dropzone:active {
  background: #ecfdf5;
}

.camera-visual {
  position: relative;
  width: 108rpx;
  height: 82rpx;
  margin-bottom: 24rpx;
  border: 5rpx solid #0f766e;
  border-radius: 20rpx;
  background: #e0f2f1;
}

.camera-top {
  position: absolute;
  top: -18rpx;
  left: 28rpx;
  width: 46rpx;
  height: 22rpx;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  background: #0f766e;
}

.camera-lens {
  position: absolute;
  top: 16rpx;
  left: 28rpx;
  width: 42rpx;
  height: 42rpx;
  border: 7rpx solid #0f766e;
  border-radius: 999rpx;
  background: #ffffff;
}

.dropzone-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.dropzone-desc {
  margin-top: 10rpx;
  color: #64748b;
  font-size: 24rpx;
}

.upload-option-panel {
  display: flex;
  margin-top: 18rpx;
  padding: 16rpx;
  border: 1rpx solid #dbe7e4;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15, 23, 42, 0.06);
}

.upload-option-button {
  flex: 1;
  margin-right: 16rpx;
}

.upload-option-button:last-child {
  margin-right: 0;
}

.selected-file-card {
  padding-bottom: 22rpx;
}

.file-main {
  display: flex;
  align-items: flex-start;
}

.file-icon {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: #16a34a;
  font-size: 28rpx;
  font-weight: 700;
}

.file-icon.pdf {
  background: #0f766e;
}

.file-info {
  min-width: 0;
  margin-left: 20rpx;
}

.file-preview {
  display: block;
  margin-top: 10rpx;
  color: #374151;
  font-size: 24rpx;
  line-height: 34rpx;
}

.file-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #eef2f7;
}

.recognize-button {
  width: 180rpx;
}

.recognize-button[disabled] {
  opacity: 0.72;
}

.progress-card {
  background: #ffffff;
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.progress-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.progress-percent {
  color: #0f766e;
  font-size: 30rpx;
  font-weight: 700;
}

.ocr-progress {
  height: 18rpx;
  margin-top: 22rpx;
}

.progress-desc {
  display: block;
  margin-top: 16rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 34rpx;
}

.vital-input-row {
  display: grid;
  grid-template-columns: 150rpx 1fr 120rpx;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
  color: #334155;
  font-size: 26rpx;
}

.vital-input-row input,
.meal-form input,
.meal-picker {
  box-sizing: border-box;
  min-height: 76rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #dbe7e4;
  border-radius: 14rpx;
  background: #f8fafc;
}

.meal-form {
  margin-top: 20rpx;
}

.meal-form > input,
.meal-picker {
  margin-bottom: 16rpx;
}

.meal-nutrients {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.meal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  margin-top: 18rpx;
}

.meal-delete,
.meal-edit {
  width: 120rpx;
  margin: 0;
  font-size: 24rpx;
}

.meal-delete {
  color: #b91c1c;
  background: #fff1f2;
}

.meal-edit {
  color: #0f766e;
  background: #ecfdf5;
}

.cancel-meal-button {
  margin-top: 12rpx;
}

.mood-picker,
.note-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mood-picker {
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  color: #0f766e;
  background: #ecfdf5;
  font-size: 26rpx;
  font-weight: 700;
}

.daily-note-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 180rpx;
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #dbe7e4;
  border-radius: 14rpx;
  background: #f8fafc;
  font-size: 26rpx;
  line-height: 38rpx;
}

.note-footer {
  margin-top: 16rpx;
  color: #94a3b8;
  font-size: 23rpx;
}

.note-save-button {
  width: 190rpx;
  margin: 0;
}

.alert-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #fee2e2;
}

.alert-row:last-child {
  border-bottom: 0;
}

.alert-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.alert-title {
  color: #991b1b;
  font-size: 27rpx;
  font-weight: 700;
}

.alert-action {
  display: block;
  margin-top: 10rpx;
  color: #0f766e;
  font-size: 23rpx;
}

.alert-read {
  opacity: 0.62;
}

.empty-record-card {
  padding: 36rpx 30rpx;
  text-align: center;
  border: 1rpx dashed #99d5cf;
  background: #f0fdfa;
}

.empty-record-title {
  display: block;
  color: #0f766e;
  font-size: 31rpx;
  font-weight: 700;
}

.empty-record-desc {
  display: block;
  margin-top: 14rpx;
  color: #64748b;
  font-size: 25rpx;
  line-height: 38rpx;
}

.trend-range-tabs {
  display: flex;
  overflow: hidden;
  border: 1rpx solid #99d5cf;
  border-radius: 999rpx;
}

.trend-range {
  padding: 8rpx 20rpx;
  color: #64748b;
  font-size: 23rpx;
}

.trend-range.active {
  color: #ffffff;
  background: #0f766e;
}

.echarts-card {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  height: 560rpx;
  padding: 0;
}

.echarts-card ec-canvas {
  width: 100%;
  height: 100%;
}

.trend-chart-state {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 48rpx;
  color: #64748b;
  text-align: center;
  background: #ffffff;
  border-radius: 20rpx;
}

.trend-chart-error {
  color: #b45309;
}

.trend-state-hint {
  color: #94a3b8;
  font-size: 24rpx;
}

.trend-loading-dot {
  width: 24rpx;
  height: 24rpx;
  border: 5rpx solid #ccfbf1;
  border-top-color: #0f766e;
  border-radius: 50%;
  animation: trend-loading-rotate 0.8s linear infinite;
}

.trend-retry-button {
  min-width: 180rpx;
  margin: 8rpx 0 0;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 2.2;
  background: #0f766e;
  border-radius: 999rpx;
}

.trend-retry-button::after {
  border: 0;
}

@keyframes trend-loading-rotate {
  to { transform: rotate(360deg); }
}

.trend-fallback {
  margin-top: 16rpx;
}

.indicator-edit-form input {
  box-sizing: border-box;
  width: 100%;
  min-height: 70rpx;
  margin-bottom: 12rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid #dbe7e4;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 25rpx;
}

.indicator-value-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.indicator-status-picker {
  padding: 15rpx 18rpx;
  border-radius: 12rpx;
  color: #0f766e;
  background: #ecfdf5;
  font-size: 25rpx;
  font-weight: 700;
}

.report-action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.report-action-grid .button {
  width: 100%;
  margin: 0;
}

.report-delete-button {
  color: #b91c1c;
  background: #fff1f2;
}

.report-history-row {
  position: relative;
}

.history-action {
  display: block;
  margin-top: 10rpx;
  color: #0f766e;
  font-size: 23rpx;
}
