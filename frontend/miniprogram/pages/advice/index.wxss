.advice-hero {
  background: linear-gradient(135deg, #0f766e 0%, #4f46e5 100%);
}

.chat-list {
  padding: 10rpx 0;
}

.chat-item {
  max-width: 86%;
  margin-bottom: 18rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(15, 23, 42, 0.06);
}

.chat-item.user {
  margin-left: auto;
  background: #e0f2f1;
}

.chat-role {
  display: block;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 700;
}

.chat-text {
  display: block;
  margin-top: 8rpx;
  color: #1f2937;
  font-size: 26rpx;
  line-height: 38rpx;
}

.plan-card {
  margin-bottom: 18rpx;
}

.plan-title {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.plan-desc {
  display: block;
  margin-top: 10rpx;
  color: #374151;
  font-size: 26rpx;
  line-height: 38rpx;
}

.knowledge-name {
  color: #111827;
  font-size: 26rpx;
  font-weight: 700;
}
