<view class="page">
  <view class="hero vitals-hero">
    <text class="eyebrow">血压血糖管理</text>
    <text class="hero-title">记录趋势与预测</text>
    <text class="hero-desc">静态展示收缩压、舒张压、空腹血糖、餐后血糖和机器学习预测结果。</text>
  </view>

  <view class="section">
    <view class="grid">
      <view class="grid-item">
        <view class="card vital-card">
          <text class="muted">今日血压</text>
          <view class="vital-value">
            <text class="value">{{current.systolic}}/{{current.diastolic}}</text>
            <text class="unit">mmHg</text>
          </view>
          <text class="tag tag-warn">偏高</text>
        </view>
      </view>
      <view class="grid-item">
        <view class="card vital-card">
          <text class="muted">空腹血糖</text>
          <view class="vital-value">
            <text class="value">{{current.fasting}}</text>
            <text class="unit">mmol/L</text>
          </view>
          <text class="tag tag-warn">预警</text>
        </view>
      </view>
      <view class="grid-item">
        <view class="card vital-card">
          <text class="muted">餐后血糖</text>
          <view class="vital-value">
            <text class="value">{{current.afterMeal}}</text>
            <text class="unit">mmol/L</text>
          </view>
          <text class="tag">可控</text>
        </view>
      </view>
      <view class="grid-item">
        <view class="card vital-card">
          <text class="muted">预测状态</text>
          <view class="vital-value">
            <text class="value">下降</text>
          </view>
          <text class="tag">趋势改善</text>
        </view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">近 7 日趋势</text>
      <text class="section-note">血压 / 血糖</text>
    </view>
    <view class="card">
      <view class="chart">
        <view class="bar-wrap" wx:for="{{records}}" wx:key="day">
          <view class="dual-bars">
            <view class="bar" style="height: {{item.bpHeight}}rpx;"></view>
            <view class="bar bar-alt" style="height: {{item.sugarHeight}}rpx;"></view>
          </view>
          <text class="bar-label">{{item.day}}</text>
        </view>
      </view>
      <view class="chart-note">
        <text>绿色表示收缩压，黄色表示空腹血糖，后续可替换为 ECharts 折线图。</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">未来预测</text>
      <text class="section-note">scikit-learn 模型输出</text>
    </view>
    <view class="list">
      <view class="list-row" wx:for="{{predictions}}" wx:key="date">
        <view class="row">
          <text class="prediction-date">{{item.date}}</text>
          <text class="tag {{item.level === '中风险' ? 'tag-warn' : ''}}">{{item.level}}</text>
        </view>
        <text class="prediction-value">血压 {{item.bp}} · 空腹血糖 {{item.sugar}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">异常预警</text>
    </view>
    <view class="card alert-card" wx:for="{{alerts}}" wx:key="title">
      <view class="row">
        <text class="alert-title">{{item.title}}</text>
        <text class="tag tag-warn">{{item.level}}</text>
      </view>
      <text class="alert-desc">{{item.desc}}</text>
    </view>
  </view>
</view>
