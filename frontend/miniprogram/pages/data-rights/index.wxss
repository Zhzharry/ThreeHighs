.rights-page { padding-bottom: 80rpx; }
.rights-hero { padding: 36rpx 32rpx; border-radius: 20rpx; color: #fff; background: linear-gradient(135deg, #0f766e, #134e4a 64%, #0f172a); }
.rights-eyebrow { display: block; color: rgba(255,255,255,.74); font-size: 23rpx; }
.rights-title { display: block; margin-top: 12rpx; font-size: 40rpx; font-weight: 800; }
.rights-desc { display: block; margin-top: 16rpx; color: rgba(255,255,255,.88); font-size: 25rpx; line-height: 40rpx; }
.rights-grid { display: grid; grid-template-columns: 1fr 1fr; overflow: hidden; border: 1rpx solid #e2e8f0; border-radius: 18rpx; background: #fff; }
.rights-item { display: flex; align-items: center; justify-content: space-between; min-height: 88rpx; padding: 18rpx 22rpx; border-right: 1rpx solid #eef2f7; border-bottom: 1rpx solid #eef2f7; }
.rights-item:nth-child(2n) { border-right: 0; }
.rights-label { color: #475569; font-size: 23rpx; }
.rights-count { color: #0f766e; font-size: 28rpx; font-weight: 800; }
.security-note { margin-top: 28rpx; padding: 26rpx; border-radius: 16rpx; color: #475569; background: #ecfdf5; font-size: 23rpx; line-height: 38rpx; }
.security-title { display: block; margin-bottom: 10rpx; color: #065f46; font-size: 27rpx; font-weight: 800; }
.export-button { width: 100%; margin-top: 28rpx; }
.last-export { display: block; margin-top: 16rpx; color: #94a3b8; text-align: center; font-size: 21rpx; }
.consent-section { margin-top: 30rpx; }
.consent-status { padding: 7rpx 14rpx; border-radius: 999rpx; font-size: 21rpx; font-weight: 700; }
.consent-status.active { color: #047857; background: #d1fae5; }
.consent-status.inactive { color: #b91c1c; background: #fee2e2; }
.consent-desc { display: block; color: #64748b; font-size: 23rpx; line-height: 38rpx; }
.consent-time { display: block; margin-top: 12rpx; color: #94a3b8; font-size: 21rpx; }
.withdraw-button { width: 100%; margin-top: 24rpx; color: #b91c1c; border: 1rpx solid #fecaca; background: #fff7f7; }
.withdraw-button::after { border: 0; }
.reauthorize-button { width: 100%; margin-top: 24rpx; }
