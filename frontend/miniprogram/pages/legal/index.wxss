.legal-page { padding-bottom: 80rpx; }
.legal-head { padding: 34rpx 30rpx; border-radius: 20rpx; color: #fff; background: linear-gradient(135deg, #0f766e, #0f172a); }
.legal-title { display: block; font-size: 40rpx; font-weight: 800; }
.legal-version { display: block; margin-top: 10rpx; color: rgba(255,255,255,.72); font-size: 22rpx; }
.legal-intro { display: block; margin-top: 20rpx; color: rgba(255,255,255,.88); font-size: 25rpx; line-height: 40rpx; }
.legal-section { margin-top: 22rpx; padding: 28rpx; border: 1rpx solid #e2e8f0; border-radius: 16rpx; background: #fff; }
.legal-section-title { display: block; color: #0f172a; font-size: 29rpx; font-weight: 800; }
.legal-content { display: block; margin-top: 14rpx; color: #475569; font-size: 25rpx; line-height: 42rpx; }
.legal-warning { margin-top: 24rpx; padding: 22rpx; border-radius: 14rpx; color: #92400e; background: #fef3c7; font-size: 22rpx; line-height: 36rpx; }
