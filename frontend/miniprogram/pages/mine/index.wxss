.mine-page {
  padding-bottom: 72rpx;
}

.mine-hero {
  display: flex;
  align-items: center;
  padding: 34rpx 30rpx;
  border-radius: 20rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #1f2937 0%, #0f766e 100%);
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.16);
}

.avatar {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  border-radius: 999rpx;
  color: #0f766e;
  background: #ffffff;
  font-size: 42rpx;
  font-weight: 700;
}

.avatar-button {
  margin: 0;
  padding: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.72);
  line-height: 1;
}

.avatar-button::after {
  border: 0;
}

.avatar-button image {
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
}

.mine-info {
  min-width: 0;
  margin-left: 24rpx;
}

.mine-name {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
}

.mine-meta {
  display: block;
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 26rpx;
}

.profile-grid {
  display: flex;
  flex-wrap: wrap;
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #ffffff;
}

.profile-cell {
  width: 50%;
  min-height: 136rpx;
  padding: 20rpx 22rpx;
  border-right: 1rpx solid #eef2f7;
  border-bottom: 1rpx solid #eef2f7;
}

.profile-cell:nth-child(2n) {
  border-right: 0;
}

.profile-cell.wide {
  width: 100%;
  border-right: 0;
}

.profile-label {
  display: block;
  color: #64748b;
  font-size: 23rpx;
}

.profile-value {
  display: block;
  margin-top: 8rpx;
  color: #111827;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 36rpx;
}

.profile-input {
  width: 100%;
  height: 58rpx;
  margin-top: 10rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  color: #111827;
  background: #f8fafc;
  font-size: 26rpx;
  font-weight: 700;
}

.menu-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.menu-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-desc {
  display: block;
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 34rpx;
}

.menu-arrow {
  color: #94a3b8;
  font-size: 44rpx;
}

.setting-value {
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 700;
}

.save-button {
  margin-top: 20rpx;
}

.profile-save-button.inactive,
.profile-save-button[disabled],
.health-save-button.inactive,
.health-save-button[disabled] {
  color: #94a3b8;
  background: #e5e7eb;
}

.profile-save-button.active,
.health-save-button.active {
  color: #ffffff;
  background: #0f766e;
  box-shadow: 0 12rpx 26rpx rgba(15, 118, 110, 0.18);
}

.pending-note {
  display: block;
  margin-top: 14rpx;
  color: #0f766e;
  font-size: 23rpx;
  line-height: 32rpx;
}

.account-form {
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #ffffff;
}

.account-field {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 18rpx 22rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.account-field:last-child {
  border-bottom: 0;
}

.account-field text {
  flex: 0 0 120rpx;
  color: #475569;
  font-size: 25rpx;
  font-weight: 700;
}

.account-field input {
  flex: 1;
  height: 62rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  color: #111827;
  background: #f8fafc;
  font-size: 27rpx;
}

.permission-note {
  display: block;
  margin-top: 18rpx;
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 34rpx;
}

.settings-form .menu-row {
  min-height: 108rpx;
}

.time-picker {
  padding: 14rpx 22rpx;
  border-radius: 12rpx;
  color: #0f766e;
  background: #ecfdf5;
  font-size: 26rpx;
  font-weight: 700;
}

.disabled-row {
  opacity: 0.48;
}

.privacy-list .menu-row {
  min-height: 116rpx;
}

.privacy-list .menu-row > view {
  flex: 1;
  min-width: 0;
  padding-right: 20rpx;
}

.consent-state {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: #b45309;
  background: #fef3c7;
  font-size: 21rpx;
  font-weight: 700;
}

.consent-state.accepted {
  color: #0f766e;
  background: #ccfbf1;
}
